---
import { Image } from "astro:assets";

const { title, subtitle, background, class: className } = Astro.props;
---

<header class:list={["masthead", className]}>
  {background.format === 'svg' ? (
    <picture>
      <slot name="sources" />
      <img src={background.src} width={background.width} height={background.height} alt="" loading="eager" fetchpriority="high" decoding="async" class="masthead-bg" />
    </picture>
  ) : (
    <Image
      src={background}
      alt=""
      widths={[576, 768, 992, 1200, 1400]}
      sizes="100vw"
      loading="eager"
      class="masthead-bg"
    />
  )}
  <div class="container position-relative px-4 px-lg-5">
    <div class="row gx-4 gx-lg-5 justify-content-center">
      <div class="col-md-10 col-lg-8 col-xl-7 text-center">
        <div class="site-heading">
          <h1>{title}</h1>
          <span class="subheading">{subtitle}</span>
        </div>
      </div>
    </div>
  </div>
</header>
