---
const BASE = import.meta.env.BASE_URL || '/';
const currentPath = Astro.url.pathname;
const { showDecorationToggle = true } = Astro.props;
---

<link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" slot="head" />

<nav class="tech-nav" id="mainNav">
  <div class="nav-inner">
    <a class="nav-brand" href={BASE}>
      <span class="nav-prompt">&gt;</span>
      <span>洛穹偎的一家言</span>
    </a>

    <button class="nav-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive"
      aria-controls="navbarResponsive" aria-expanded="false" aria-label="Toggle navigation">
      <i class="fa-solid fa-bars"></i>
    </button>

    <div class="collapse" id="navbarResponsive">
      <ul class="nav-menu">
        <li><a class={currentPath === BASE ? 'active' : ''} href={BASE}>Home</a></li>
        <li><a class={currentPath === `${BASE}about/` ? 'active' : ''} href={`${BASE}about/`}>About</a></li>
        <li><a class={currentPath === `${BASE}articles/` ? 'active' : ''} href={`${BASE}articles/`}>Articles</a></li>
        <li><a class={currentPath === `${BASE}tools/` ? 'active' : ''} href={`${BASE}tools/`}>Tools</a></li>
        {showDecorationToggle && (
          <li class="sys-status-item">
            <button
              class="sys-status"
              type="button"
              id="sysStatusBtn"
              aria-pressed="true"
              aria-label="关闭边缘脉冲装饰"
              title="切换边缘脉冲装饰"
            >
              <span class="sys-dot" aria-hidden="true"></span>
              <span class="sys-text">PULSE: ON</span>
            </button>
          </li>
        )}
        <li class="theme-item">
          <button class="theme-toggle" type="button" id="themeToggle" aria-pressed="false" title="切换主题">
            🌙
          </button>
        </li>
      </ul>
    </div>
  </div>
</nav>

<script is:inline>
(() => {
  if (typeof window === 'undefined') return;

  // Theme toggle
  const KEY = 'theme-preference';
  const root = document.documentElement;
  const btn = document.getElementById('themeToggle');
  if (btn) {
    const apply = (mode) => {
      const isDark = mode === 'dark';
      root.setAttribute('data-bs-theme', isDark ? 'dark' : 'light');
      btn.setAttribute('aria-pressed', String(isDark));
      btn.textContent = isDark ? '🌙' : '☀️';
    };

    const stored = localStorage.getItem(KEY);
    const systemPrefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    let mode = stored || (systemPrefersDark ? 'dark' : 'light');
    apply(mode);

    btn.addEventListener('click', () => {
      mode = mode === 'dark' ? 'light' : 'dark';
      localStorage.setItem(KEY, mode);
      apply(mode);
    });
  }

  // System status toggle
  const SYS_KEY = 'my-system';
  const sysBtn = document.getElementById('sysStatusBtn');
  const sysDot = sysBtn?.querySelector('.sys-dot');
  const sysText = sysBtn?.querySelector('.sys-text');
  if (sysBtn && sysDot && sysText) {
    let storedSystemState = null;
    try {
      storedSystemState = localStorage.getItem(SYS_KEY);
    } catch {
      // 隐私模式下存储可能不可用，此时仍保留本次页面内的开关能力。
    }
    let systemOn = storedSystemState === null ? true : storedSystemState === '1';

    const updateSys = (on, persist = true) => {
      systemOn = on;
      if (persist) {
        try {
          localStorage.setItem(SYS_KEY, systemOn ? '1' : '0');
        } catch {
          // 存储失败不影响当前页面的装饰状态。
        }
      }
      sysDot.classList.toggle('offline', !systemOn);
      sysText.textContent = systemOn ? 'PULSE: ON' : 'PULSE: OFF';
      sysBtn.setAttribute('aria-pressed', String(systemOn));
      sysBtn.setAttribute('aria-label', systemOn ? '关闭边缘脉冲装饰' : '开启边缘脉冲装饰');
      document.dispatchEvent(new CustomEvent('system-status-change', { detail: { on: systemOn } }));
    };

    updateSys(systemOn);

    sysBtn.addEventListener('click', () => {
      updateSys(!systemOn);
    });

    window.addEventListener('storage', (event) => {
      if (event.key === SYS_KEY) updateSys(event.newValue === '1', false);
    });
  }
})();
</script>
