---
interface Props {
  class?: string;
  density?: number;
  speed?: number;
  paused?: boolean;
  interactive?: boolean;
  respectReducedMotion?: boolean;
  burnMemory?: boolean;
  particles?: boolean;
  seed?: number;
  aspectRatio?: number;
  ariaLabel?: string;
}

const {
  class: className = "",
  density = 43,
  speed = 6,
  paused = false,
  interactive = false,
  respectReducedMotion = true,
  burnMemory = false,
  particles = false,
  seed,
  aspectRatio = 74 / 48,
  ariaLabel = "康威生命游戏余烬包络装饰",
} = Astro.props;
---

<canvas
  class:list={["smolder-life-decoration", className]}
  data-smolder-life
  data-density={Math.max(5, Math.min(90, density))}
  data-speed={Math.max(1, Math.min(8, speed))}
  data-paused={String(paused)}
  data-interactive={String(interactive)}
  data-reduced-motion={String(respectReducedMotion)}
  data-burn-memory={String(burnMemory)}
  data-particles={String(particles)}
  data-seed={seed}
  width="740"
  height="480"
  style={`--smolder-aspect-ratio: ${Math.max(0.5, Math.min(3, aspectRatio))}`}
  aria-hidden={interactive ? undefined : "true"}
  aria-label={interactive ? ariaLabel : undefined}
  role={interactive ? "img" : undefined}
  tabindex={interactive ? 0 : undefined}
></canvas>

<style>
  .smolder-life-decoration {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--smolder-aspect-ratio, 1.5417);
    overflow: hidden;
    background: #d3c4a6;
    border: 1px solid rgba(46, 38, 29, 0.18);
    contain: layout paint style;
    pointer-events: none;
    user-select: none;
  }

  .smolder-life-decoration[data-interactive="true"] {
    pointer-events: auto;
    touch-action: none;
    cursor: crosshair;
  }

</style>

<script>
  import "../scripts/SmolderLifeRuntime";
</script>
