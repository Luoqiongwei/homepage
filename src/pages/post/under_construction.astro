---
import BaseLayout from "../../layouts/BaseLayout.astro";

const defaultProgram = `q0 1 -> q1 2 L
q1 1 -> q1 0 L
q1 0 -> q1 1 L
q1 B -> q2 B R
q2 0 -> q2 0 R
q2 1 -> q2 1 R
q2 2 -> q3 0 R
q3 0 -> q3 1 R
q3 1 -> q3 0 R
q3 B -> e B L`;
---

<BaseLayout title="施工中" description="洛穹偎的一家言 - 页面建设中">
  <main class="turing-page">
    <header class="page-intro">
      <div class="construction-site">
        <div class="construction-copy">
          <h1>施工<span class="unfinished-glyph">中</span></h1>
          <p class="intro-lead"><strong>恭喜你闯入了这个神秘的页面。</strong></p>
          <p class="intro-description">这里原本是为尚未完成的内容准备的占位页。但我想，既然你已经来了，不妨玩一玩这个小游戏：</p>
        </div>

        <div class="instruction-blueprint" role="img" aria-label="q0 1 -> q1 2 L" aria-live="off">
          <div class="blueprint-heading">
            <code id="blueprint-rule">q0 1 -&gt; q1 2 L</code>
            <span class="blueprint-marker" aria-hidden="true"></span>
          </div>
          <div class="instruction-flow" aria-hidden="true">
            <div class="instruction-before">
              <span id="blueprint-state">q0</span>
              <span id="blueprint-read">1</span>
            </div>
            <span class="transfer-arrow">→</span>
            <div class="instruction-after">
              <span id="blueprint-next">q1</span>
              <span id="blueprint-write">2</span>
              <span id="blueprint-direction">L</span>
            </div>
          </div>
          <div class="blueprint-foot" aria-hidden="true"><span class="blueprint-dimension"></span></div>
        </div>
      </div>
      <div class="construction-seam" aria-hidden="true"><span></span></div>
    </header>

    <section aria-labelledby="machine-title">
      <div class="section-heading">
        <h2 id="machine-title">这是一个最简单的图灵机模拟器。</h2>
      </div>
      <p id="tm-instructions">编写转移规则，初始化带并运行图灵机。</p>
      <p class="original-hint">（建议使用 <strong>B</strong> 表示空格，也支持 <strong>_</strong> 或 <strong>□</strong>；状态名可用 <code>q0</code>、<code>q1</code> 或 <code>e</code> 等。）</p>

      <form id="tm-form">
        <div class="machine-panel">
          <dl class="machine-stats">
            <div><dt>当前状态：</dt><dd id="tm-state">q0</dd></div>
            <div><dt>读头索引：</dt><dd id="tm-head">3</dd></div>
          </dl>
          <div class="tape-window">
            <div id="tm-tape" class="tape-track" role="list" aria-label="带"></div>
          </div>
          <output class="result-row" id="tm-output" aria-live="off">1001001</output>

          <div class="execution-controls">
            <div class="execution-buttons">
              <button type="submit">初始化</button>
              <button id="tm-step" type="button">执行一步</button>
              <button class="primary-button" id="tm-run" type="button">自动运行</button>
              <button id="tm-stop" type="button" disabled>停止</button>
            </div>
          </div>
          <p class="machine-status" id="tm-status" role="status" aria-live="polite" aria-atomic="true"></p>
        </div>

        <fieldset class="program-editor" id="tm-editor" aria-labelledby="tm-instructions">
          <div class="rules-editor">
            <textarea id="tm-rules" rows="10" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder="在此输入规则，每行一条，格式：q0 1 -> q1 2 L" aria-label="在此输入规则，每行一条，格式：q0 1 -> q1 2 L" aria-describedby="tm-error">{defaultProgram}</textarea>
          </div>
          <div class="initial-settings">
            <div class="field">
              <label for="tm-input">初始带（只写带中间的内容）</label>
              <input id="tm-input" type="text" value="1001001" placeholder="例如：1001001" spellcheck="false" autocapitalize="off" autocomplete="off" aria-describedby="tm-input-hint" />
            </div>
            <div class="field">
              <label for="tm-position">读写头位置</label>
              <select id="tm-position">
                <option value="start">start（左端）</option>
                <option value="center" selected>center（中间）</option>
                <option value="end">end（右端）</option>
              </select>
            </div>
            <p id="tm-input-hint" class="field-hint">提示：建议使用 <strong>B</strong> 代表空白，或用 <strong>_</strong>、<strong>□</strong>。状态 <strong>e</strong> 常用于终止（halt）。</p>
          </div>
        </fieldset>
        <p class="program-error" id="tm-error" role="alert" hidden></p>
      </form>

      <details class="machine-guide">
        <summary>练习（示例题）</summary>
        <div class="guide-content">
          <p>我们从一个带中某个位置的 <code>1</code> 开始（请保证你的初始带和带头位置满足这一点，否则示例程序无法运行），将队列中的1变为0，0变为1，最后停止在初始01串的最右端。示例程序做的是先扫描到最左端再返回，并向右直到最右端，进入终止状态。</p>
          <pre class="example">{defaultProgram}</pre>
        </div>
      </details>
    </section>
    <template id="tm-cell-template">
      <div class="tape-cell" role="listitem">
        <span class="cell-symbol"></span>
        <span class="cell-index" aria-hidden="true"></span>
      </div>
    </template>
  </main>
</BaseLayout>

<script>
  import { parseProgram, TuringMachine } from "../../scripts/turing-machine.mjs";

  const page = document.querySelector<HTMLElement>(".turing-page")!;
  const find = <T extends HTMLElement>(selector: string) => page.querySelector<T>(selector)!;
  const form = find<HTMLFormElement>("#tm-form");
  const editor = find<HTMLFieldSetElement>("#tm-editor");
  const rulesInput = find<HTMLTextAreaElement>("#tm-rules");
  const tapeInput = find<HTMLInputElement>("#tm-input");
  const positionInput = find<HTMLSelectElement>("#tm-position");
  const runButton = find<HTMLButtonElement>("#tm-run");
  const stopButton = find<HTMLButtonElement>("#tm-stop");
  const stepButton = find<HTMLButtonElement>("#tm-step");
  const status = find("#tm-status");
  const errorMessage = find("#tm-error");
  const tape = find("#tm-tape");
  const cellTemplate = find<HTMLTemplateElement>("#tm-cell-template");
  const AUTO_STEP_LIMIT = 10_000;
  const STEP_DELAY = 250;

  let machine: TuringMachine | undefined;
  let timer: ReturnType<typeof setTimeout> | undefined;
  let running = false;
  let dirty = false;
  let autoSteps = 0;

  const symbol = (value: string) => value === "_" ? "□" : value;

  function renderBlueprint() {
    const next = machine && !dirty && !machine.haltReason
      ? machine.program.get(machine.state)?.get(machine.read()) : undefined;
    const rule = next && machine
      ? `${machine.state} ${symbol(machine.read())} -> ${next.state} ${symbol(next.write)} ${next.direction}` : "";
    find("#blueprint-rule").textContent = rule;
    find(".instruction-blueprint").setAttribute("aria-label", dirty || !machine ? "初始化" : rule || haltMessage());
    find("#blueprint-state").textContent = machine && !dirty ? machine.state : "—";
    find("#blueprint-read").textContent = machine && !dirty ? symbol(machine.read()) : "—";
    find("#blueprint-next").textContent = next?.state ?? "—";
    find("#blueprint-write").textContent = next ? symbol(next.write) : "—";
    find("#blueprint-direction").textContent = next?.direction ?? "—";
  }

  function cancelRun() {
    clearTimeout(timer);
    timer = undefined;
    running = false;
  }

  function haltMessage() {
    if (!machine) return "";
    if (machine.haltReason === "terminal") return `已进入终止状态 ${machine.state}，程序停止。`;
    return `无匹配规则，程序停止。（当前状态：${machine.state}，读到符号：${symbol(machine.read())}）`;
  }

  function renderTape() {
    if (!machine) return;
    let count = Math.max(5, Math.min(21, Math.floor(tape.clientWidth / 48)));
    if (count % 2 === 0) count--;
    const start = machine.head - Math.floor(count / 2);
    const fragment = document.createDocumentFragment();
    for (let index = start; index < start + count; index++) {
      const cell = cellTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const value = symbol(machine.read(index));
      const isHead = index === machine.head;
      cell.classList.toggle("read-head", isHead);
      cell.setAttribute("aria-label", `读头索引：${index}，${value}${isHead ? "，读写头位置" : ""}`);
      if (isHead) cell.setAttribute("aria-current", "true");
      cell.querySelector(".cell-symbol")!.textContent = value;
      cell.querySelector(".cell-index")!.textContent = String(index);
      fragment.append(cell);
    }
    tape.style.gridTemplateColumns = `repeat(${count}, minmax(0, 1fr))`;
    tape.replaceChildren(fragment);
  }

  function render() {
    page.dataset.machine = dirty ? "pending" : running ? "running" : machine?.haltReason ? "halted" : "idle";
    editor.disabled = running;
    runButton.disabled = running || !machine || dirty || Boolean(machine.haltReason);
    stopButton.disabled = !running;
    stepButton.disabled = running || !machine || dirty || Boolean(machine.haltReason);
    renderBlueprint();
    if (!machine) return;
    find("#tm-state").textContent = machine.state;
    find("#tm-head").textContent = String(machine.head);
    find("#tm-output").textContent = machine.output() || "□";
    renderTape();
  }

  function initialize(focusError = true) {
    cancelRun();
    try {
      machine = new TuringMachine({
        program: parseProgram(rulesInput.value),
        input: tapeInput.value,
        headPosition: positionInput.value as "start" | "center" | "end",
      });
      dirty = false;
      rulesInput.removeAttribute("aria-invalid");
      errorMessage.hidden = true;
      errorMessage.textContent = "";
      status.textContent = machine.haltReason ? haltMessage() : "";
    } catch (error) {
      dirty = true;
      const problem = error as Error & { line?: number };
      const lines = rulesInput.value.split("\n");
      errorMessage.textContent = problem.line
        ? `无法解析规则行：${problem.line} ${lines[problem.line - 1] ?? ""}`
        : find("#tm-input-hint").textContent;
      errorMessage.hidden = false;
      status.textContent = "";
      if (problem.line) {
        rulesInput.setAttribute("aria-invalid", "true");
        if (focusError) {
          rulesInput.focus();
          const start = lines.slice(0, problem.line - 1).join("\n").length + (problem.line > 1 ? 1 : 0);
          rulesInput.setSelectionRange(start, start + (lines[problem.line - 1]?.length ?? 0));
        }
      }
    }
    render();
  }

  function tick() {
    timer = undefined;
    if (!running || !machine) return;
    machine.step();
    autoSteps++;
    if (machine.haltReason) {
      cancelRun();
      status.textContent = haltMessage();
    } else if (autoSteps >= AUTO_STEP_LIMIT) {
      cancelRun();
      status.textContent = "程序停止。";
    }
    render();
    if (running) timer = setTimeout(tick, STEP_DELAY);
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    initialize();
  });

  runButton.addEventListener("click", () => {
    if (running || !machine || dirty || machine.haltReason) return;
    running = true;
    autoSteps = 0;
    status.textContent = "";
    timer = setTimeout(tick, STEP_DELAY);
    render();
  });

  stopButton.addEventListener("click", () => {
    cancelRun();
    status.textContent = "";
    render();
  });

  stepButton.addEventListener("click", () => {
    if (!machine || running || dirty || machine.haltReason) return;
    machine.step();
    status.textContent = machine.haltReason ? haltMessage() : "";
    render();
  });

  editor.addEventListener("input", () => {
    dirty = true;
    rulesInput.removeAttribute("aria-invalid");
    errorMessage.hidden = true;
    status.textContent = "";
    render();
  });

  window.addEventListener("pagehide", () => {
    if (!running) return;
    cancelRun();
    status.textContent = "";
    render();
  });
  page.dataset.effects = String(document.getElementById("sysStatusBtn")?.getAttribute("aria-pressed") !== "false");
  document.addEventListener("system-status-change", (event) => {
    page.dataset.effects = String((event as CustomEvent<{ on: boolean }>).detail.on);
  });
  new ResizeObserver(renderTape).observe(tape);
  initialize(false);
</script>

<style>
  .turing-page {
    --tm-accent: #176e72;
    --tm-accent-ink: #fff;
    --tm-muted: #626e71;
    --tm-line: #d7dfe0;
    --tm-surface: #f5f7f6;
    --tm-cell: #fff;
    --tm-head: #e0efeb;
    --tm-error: #a33434;
    --tm-work: #98601c;
    --tm-grid: rgba(92, 119, 112, .1);
    --tm-blueprint: #edf2ee;
    max-width: 1192px;
    margin: 0 auto;
    padding: 144px 28px 80px;
    font-size: 16px;
    line-height: 1.75;
  }
  :global(:root[data-bs-theme="dark"]) .turing-page {
    --tm-accent: #9ad6cd;
    --tm-accent-ink: #172c2a;
    --tm-muted: #a7b5b7;
    --tm-line: #3b4647;
    --tm-surface: #202727;
    --tm-cell: #272f30;
    --tm-head: #304b45;
    --tm-error: #ffb3ac;
    --tm-work: #e8bf77;
    --tm-grid: rgba(159, 197, 186, .09);
    --tm-blueprint: #222d2b;
  }
  .turing-page p, .turing-page dl, .turing-page dd { margin: 0; }
  .page-intro { margin-bottom: 40px; }
  .construction-site { position: relative; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: center; gap: 64px; padding: 34px 0 40px; }
  .construction-site::before { content: ""; position: absolute; inset: 0 -18px 0 38%; background-image: linear-gradient(var(--tm-grid) 1px, transparent 1px), linear-gradient(90deg, var(--tm-grid) 1px, transparent 1px); background-size: 24px 24px; mask-image: linear-gradient(90deg, transparent, #000 35%, #000 90%, transparent); pointer-events: none; }
  .construction-copy, .instruction-blueprint { position: relative; }
  .page-intro h1 { margin: 14px 0 24px; font-size: clamp(4.5rem, 8vw, 6.3rem); line-height: 1.2; letter-spacing: -.065em; }
  .unfinished-glyph { position: relative; display: inline-block; margin-left: .07em; padding: .015em .06em; border: 1px dashed var(--tm-work); border-right-color: transparent; letter-spacing: 0; }
  .unfinished-glyph::before { content: ""; position: absolute; top: -12px; bottom: -12px; left: -10px; width: 4px; background: repeating-linear-gradient(0deg, var(--tm-work) 0 1px, transparent 1px 8px); opacity: .7; }
  .unfinished-glyph::after { content: ""; position: absolute; top: -9px; left: -14px; right: -14px; height: 4px; border-bottom: 1px solid var(--tm-work); background: repeating-linear-gradient(90deg, var(--tm-work) 0 1px, transparent 1px 8px); opacity: .7; }
  .construction-copy .intro-lead { font-size: 21px; letter-spacing: .025em; }
  .construction-copy .intro-description { max-width: 28em; margin-top: 12px; color: var(--tm-muted); font-size: 15px; }
  .instruction-blueprint { padding: 22px 24px 18px; background: var(--tm-blueprint); border: 1px solid var(--tm-line); box-shadow: 7px 7px 0 var(--tm-grid); }
  .instruction-blueprint::before, .instruction-blueprint::after { content: ""; position: absolute; width: 16px; height: 16px; border-color: var(--tm-work); border-style: solid; pointer-events: none; }
  .instruction-blueprint::before { top: -5px; left: -5px; border-width: 1px 0 0 1px; }
  .instruction-blueprint::after { right: -5px; bottom: -5px; border-width: 0 1px 1px 0; }
  .blueprint-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .turing-page .blueprint-heading code { min-height: 21px; font-size: 12px; overflow-wrap: anywhere; }
  .blueprint-marker { width: 6px; height: 6px; flex-shrink: 0; background: var(--tm-work); }
  .instruction-flow { display: grid; grid-template-columns: minmax(0, 2fr) 22px minmax(0, 3fr); gap: 12px; align-items: end; margin-top: 24px; }
  .instruction-before, .instruction-after { display: grid; gap: 10px; }
  .instruction-before { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .instruction-after { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .instruction-before > span, .instruction-after > span { display: grid; place-items: center; min-height: 48px; padding: 6px 2px; border-bottom: 1px solid var(--tm-line); font: 20px/1.4 "JetBrains Mono", monospace; overflow-wrap: anywhere; }
  .instruction-after > span { border-bottom: 2px solid var(--tm-accent); background: var(--tm-head); color: var(--tm-accent); }
  .transfer-arrow { display: grid; align-items: center; height: 48px; color: var(--tm-work); font: 24px/1 "JetBrains Mono", monospace; }
  .blueprint-foot { display: flex; align-items: center; margin-top: 24px; }
  .blueprint-dimension { position: relative; flex: 1; height: 7px; border-left: 1px solid var(--tm-line); border-right: 1px solid var(--tm-line); }
  .blueprint-dimension::after { content: ""; position: absolute; top: 3px; left: 0; right: 0; border-top: 1px solid var(--tm-line); }
  .construction-seam { display: flex; align-items: center; gap: 0; height: 8px; }
  .construction-seam span { width: 144px; height: 100%; background: repeating-linear-gradient(135deg, var(--tm-work) 0 4px, transparent 4px 11px); background-size: 16px 16px; opacity: .75; }
  .construction-seam::after { content: ""; flex: 1; height: 1px; background: var(--tm-line); }
  .turing-page[data-machine="running"][data-effects="true"] .construction-seam span { animation: site-work 2s linear infinite; }
  .turing-page[data-machine="running"] .blueprint-marker { background: var(--tm-accent); box-shadow: 0 0 0 4px var(--tm-head); }
  .turing-page[data-machine="pending"] .instruction-flow { opacity: .45; }
  .turing-page[data-machine="halted"] .blueprint-marker { background: var(--tm-muted); }
  @keyframes site-work { to { background-position: 32px 0; } }
  .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
  .section-heading h2 { margin: 0 0 8px; font-size: 1.5rem; scroll-margin-top: 110px; }
  .turing-page .original-hint { margin: 8px 0 24px; color: var(--tm-muted); font-size: 14px; }
  .machine-panel { position: relative; padding: 28px; border: 1px solid var(--tm-line); border-radius: 2px; background: var(--tm-surface); }
  .machine-panel::before { content: ""; position: absolute; top: -2px; left: 28px; width: 36px; height: 3px; background: var(--tm-work); }
  .machine-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .machine-stats > div + div { border-left: 1px solid var(--tm-line); padding-left: 24px; }
  .machine-stats dt { color: var(--tm-muted); font-size: 13px; font-weight: 400; }
  .machine-stats dd { font-family: "JetBrains Mono", monospace; font-size: 1.65rem; overflow-wrap: anywhere; }
  .tape-window { position: relative; margin: 22px -28px 0; padding: 26px 28px 14px; border-top: 1px solid var(--tm-line); border-bottom: 1px solid var(--tm-line); background: var(--tm-cell); }
  .tape-window::before, .tape-window::after { content: ""; position: absolute; left: 0; right: 0; height: 4px; background: radial-gradient(circle, var(--tm-line) 1.5px, transparent 2px) 0 0 / 14px 4px; pointer-events: none; }
  .tape-window::before { top: 6px; }
  .tape-window::after { bottom: 5px; }
  .tape-track { display: grid; gap: 4px; min-height: 78px; }
  .tape-cell { position: relative; min-width: 0; text-align: center; font-family: "JetBrains Mono", monospace; }
  .cell-symbol { display: grid; place-items: center; min-height: 48px; border: 1px solid var(--tm-line); background: var(--tm-cell); font-size: 21px; }
  .cell-index { display: block; margin-top: 5px; color: var(--tm-muted); font-size: 10px; line-height: 1.5; }
  .read-head .cell-symbol { border: 2px solid var(--tm-accent); background: var(--tm-head); color: var(--tm-accent); font-weight: 700; }
  .read-head::before { content: ""; position: absolute; top: -11px; left: calc(50% - 4px); border: 4px solid transparent; border-top-color: var(--tm-accent); }
  .turing-page code { font-family: "JetBrains Mono", monospace; color: var(--tm-accent); font-size: .88em; }
  .result-row { display: block; padding-top: 18px; font: 14px/1.7 "JetBrains Mono", monospace; overflow-wrap: anywhere; }
  .execution-controls { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; margin-top: 20px; padding-top: 22px; border-top: 1px solid var(--tm-line); }
  .execution-buttons { display: flex; flex-wrap: wrap; gap: 8px; }
  .turing-page button { border: 1px solid var(--tm-line); border-radius: 6px; padding: 9px 16px; background: var(--tm-cell); color: inherit; font: inherit; font-size: 14px; line-height: 1.5; cursor: pointer; }
  .turing-page button:hover:not(:disabled) { border-color: var(--tm-accent); color: var(--tm-accent); }
  .turing-page .primary-button { min-width: 94px; background: var(--tm-accent); border-color: var(--tm-accent); color: var(--tm-accent-ink); }
  .turing-page .primary-button:hover:not(:disabled) { color: var(--tm-accent-ink); filter: brightness(.92); }
  .turing-page button:disabled { opacity: .45; cursor: not-allowed; }
  .turing-page .machine-status { margin-top: 18px; color: var(--tm-muted); font-size: 14px; overflow-wrap: anywhere; }
  .machine-status:empty { display: none; }
  .program-editor { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 30px; margin: 30px 0 0; padding: 0; border: 0; min-width: 0; }
  .program-editor:disabled { opacity: .6; }
  .rules-editor, .initial-settings, .field { min-width: 0; }
  .turing-page label { font-size: 14px; font-weight: 600; }
  .turing-page textarea, .initial-settings input, .turing-page select { border: 1px solid var(--tm-line); border-radius: 6px; background: var(--tm-cell); color: inherit; font: inherit; font-size: 14px; padding: 9px 11px; max-width: 100%; }
  .turing-page textarea { display: block; width: 100%; resize: vertical; min-height: 240px; font-family: "JetBrains Mono", monospace; font-size: 14px; line-height: 1.9; tab-size: 2; }
  .field { display: grid; gap: 7px; }
  .field + .field { margin-top: 18px; }
  .initial-settings > .field:first-child { margin-top: 3px; }
  .initial-settings input, .initial-settings select { width: 100%; }
  .initial-settings input { font-family: "JetBrains Mono", monospace; }
  .turing-page .field-hint { margin-top: 7px; font-size: 12px; color: var(--tm-muted); line-height: 1.65; }
  .field .field-hint { margin-top: 0; }
