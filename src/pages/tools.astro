---
import BaseLayout from "../layouts/BaseLayout.astro";
import Live2DCharacter from "../components/Live2DCharacter.astro";

const BASE = import.meta.env.BASE_URL || '/';
---

<BaseLayout
  title="洛穹偎的一家言 - 工具与实验"
  description="一些尚未完全成型的实验与工具。"
>

  <div class="container px-4 px-lg-5">
    <div class="row gx-4 gx-lg-5 justify-content-center">
      <div class="col-md-10 col-lg-8 col-xl-7">

        <section class="tool-section">
          <br><br><br><br><br>
          <h1 style="text-align:center;">工具 · 实验</h1>
          <br><br>
          <h2 class="mb-3">关于这个页面</h2>
          <p>
            这里收集的是一些可能是工具、实验、半成品，或者只是一个尚未想清楚用途的想法。
          </p>
        </section>

        <hr class="my-5" />

        <section class="tool-section">
          <h2 class="mb-4">已上线的实验</h2>

          <div class="tool-item">
            <div class="tool-heading">
              <h3 class="mb-2">从夯到拉</h3>
            </div>
            <p class="tool-meta">
              类型：交互式工具
            </p>
            <a
              class="btn btn-outline-primary btn-sm"
              href={`${BASE}tools/from-pounding-to-sharp-criticism/`}
            >
              进入 →
            </a>
          </div>

          <br>

          <div class="tool-item">
            <div class="tool-heading">
              <h3 class="mb-2">熔炉 · 边界站</h3>
              <span class="tool-status">PROTOTYPE 0.3.2</span>
            </div>
            <p class="tool-meta">类型：资源循环与工业自动化游戏原型</p>
            <p class="tool-desc">
              从铁铜实验起步，管理电力、废热、库存与副产物，逐步建立连续生产线并完成第一枚锚点。
              当前版本包含初步引导、离线存档与材料图鉴。
            </p>
            <div class="tool-actions">
              <a
                class="btn btn-primary btn-sm"
                href={`${BASE}tools/furnace/index.html`}
                target="_blank"
                rel="noopener"
              >
                进入边界站 →
              </a>
              <a class="btn btn-outline-primary btn-sm" href={`${BASE}tools/furnace-roadmap-v0-3/`}>
                开发路线图
              </a>
              <a class="btn btn-outline-primary btn-sm" href={`${BASE}tools/furnace-task-catalog-v0-3-2/`}>
                任务与图鉴
              </a>
              <a class="btn btn-outline-primary btn-sm" href={`${BASE}tools/furnace-materials-routes/`}>
                材料与合成路线
              </a>
            </div>
          </div>

          <br>
          
          <div class="tool-item">
            <div class="tool-heading">
              <h3 class="mb-2">Marching Cubes</h3>
            </div>
            <p class="tool-meta">类型：技术博客</p>
            <a class="btn btn-outline-primary btn-sm" href={`${BASE}tools/AD-MC/`}>
              进入 →
            </a>
          </div>

          <br>
                
          <div class="tool-item">
            <div class="tool-heading">
              <h3 class="mb-2">Live2D  疏燕 · 偎红</h3>
            </div>
            <section class="site-companion" aria-label="疏燕">
              <Live2DCharacter />
            </section>
          </div>

        </section>

        <hr class="my-5" />

        <section class="tool-section">
          <h2 class="mb-3">进行中的想法</h2>
          <ul>
            <li>与文章内容联动的小工具</li>
            <li>图灵完备？</li>
          </ul>
        </section>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
.tool-section {
  margin-bottom: 3rem;
}

.tool-item {
  margin-bottom: 2rem;
}

.tool-desc {
  margin-bottom: 1rem;
  color: #555;
}

.tool-meta {
  font-size: 0.9rem;
  color: #888;
  margin-bottom: 0.75rem;
}

.furnace-item {
  padding: 1.5rem;
  border: 1px solid rgba(108, 117, 125, 0.25);
  border-radius: 0.75rem;
  background: rgba(108, 117, 125, 0.05);
}

.tool-heading,
.tool-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.tool-heading {
  justify-content: space-between;
}

.tool-status {
  padding: 0.2rem 0.55rem;
  border: 1px solid currentColor;
  border-radius: 999px;
  color: #8a5a24;
  font-family: monospace;
  font-size: 0.75rem;
  letter-spacing: 0.04em;
}

:global([data-bs-theme="dark"]) .tool-desc {
  color: #c7c7c7;
}
</style>
